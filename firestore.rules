rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // CardioVault uses the existing users/{uid} account namespace.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /patients/{documentId} {
        allow read, write: if isOwner(uid);
      }
      match /units/{documentId} {
        allow read, write: if isOwner(uid);
      }
      match /beds/{documentId} {
        allow read, write: if isOwner(uid);
      }
      match /settings/{documentId} {
        allow read, write: if isOwner(uid);
      }
      match /metadata/{documentId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny every unrelated collection/path by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

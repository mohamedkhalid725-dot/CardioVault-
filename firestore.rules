rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------------
    function signedIn() { return request.auth != null; }

    // Exactly one platform owner exists, recorded in /platformOwners/{uid} and
    // written only from the Firebase console. No customer account can ever be an
    // owner, and ownerUid on a workspace no longer grants anything.
    function platformOwner() {
      return signedIn() && exists(/databases/$(database)/documents/platformOwners/$(request.auth.uid));
    }
    // Administrative authority over a workspace belongs to the platform owner
    // only. Customers work through unit membership, never through ownership.
    function adminOf(workspaceId) { return platformOwner(); }

    // -----------------------------------------------------------------------------
    function memberPath(workspaceId) { return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid); }
    function memberData(workspaceId) { return get(memberPath(workspaceId)).data; }
    function member(workspaceId) {
      return signedIn()
        && exists(memberPath(workspaceId))
        && memberData(workspaceId).active != false
        && memberData(workspaceId).forceReauth != true;
    }
    function workspacePath(workspaceId) { return /databases/$(database)/documents/workspaces/$(workspaceId); }
    function workspaceExists(workspaceId) { return workspaceId != '' && exists(workspacePath(workspaceId)); }
    function workspaceCreatedByCaller(workspaceId) {
      return workspaceExists(workspaceId)
        && get(workspacePath(workspaceId)).data.get('createdBy', '') == request.auth.uid;
    }
    // Onboarding (see subscriptionRequests below): the account that created a
    // workspace may file ONE pending subscription request in it BEFORE any
    // membership exists. The account must own the workspace, and must not be a
    // member of it yet - the moment a membership exists the normal rules apply.
    function onboardingWorkspace(workspaceId) {
      return signedIn()
        && workspaceId == onboardingWorkspaceId(request.auth.uid)
        && workspaceCreatedByCaller(workspaceId)
        && get(workspacePath(workspaceId)).data.get('onboarding', false) == true
        && !exists(memberPath(workspaceId));
    }
    // Deterministic onboarding identifiers, enforced inside the rules (not only
    // in client code): workspace ws_ob_<uid>, request onboard-<uid>.
    function onboardingWorkspaceId(uid) { return 'ws_ob_' + uid; }
    function onboardingRequestId(uid) { return 'onboard-' + uid; }
    function onboardingProvisioningPath(uid) { return /databases/$(database)/documents/onboardingProvisioning/$(uid); }
    function onboardingRequestPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/subscriptionRequests/$(onboardingRequestId(uid));
    }
    function onboardingRequestExists(workspaceId, uid) { return exists(onboardingRequestPath(workspaceId, uid)); }
    function onboardingRequestData(workspaceId, uid) { return get(onboardingRequestPath(workspaceId, uid)).data; }
    function isOnboardingWorkspace(workspaceId) {
      return workspaceExists(workspaceId)
        && get(workspacePath(workspaceId)).data.get('onboarding', false) == true
        && get(workspacePath(workspaceId)).data.get('createdBy', '') is string
        && workspaceId == onboardingWorkspaceId(get(workspacePath(workspaceId)).data.get('createdBy', ''));
    }
    function onboardingProvisioningComplete(workspaceId, uid) {
      return workspaceId == onboardingWorkspaceId(uid)
        && workspaceExists(workspaceId)
        && get(workspacePath(workspaceId)).data.get('createdBy', '') == uid
        && onboardingRequestExists(workspaceId, uid)
        && onboardingRequestData(workspaceId, uid).get('onboarding', false) == true
        && onboardingRequestData(workspaceId, uid).get('subscriberId', '') == uid
        && onboardingRequestData(workspaceId, uid).get('status', '') == 'approved'
        && onboardingRequestData(workspaceId, uid).get('paymentVerified', false) == true
        && onboardingRequestData(workspaceId, uid).get('provisioningState', '') == 'complete'
        && onboardingRequestData(workspaceId, uid).get('provisionedUnitIds', []) is list
        && onboardingRequestData(workspaceId, uid).get('provisionedUnitIds', []).size() > 0
        && onboardingRequestData(workspaceId, uid).get('unitAccessCodes', []) is list
        && onboardingRequestData(workspaceId, uid).get('unitAccessCodes', []).size() > 0;
    }
    function onboardingMemberBootstrap(workspaceId, uid) {
      return signedIn()
        && request.auth.uid == uid
        && workspaceId == onboardingWorkspaceId(uid)
        && member(workspaceId)
        && onboardingProvisioningComplete(workspaceId, uid);
    }
    function onboardingTrialMayStart(workspaceId, uid) {
      return onboardingMemberBootstrap(workspaceId, uid)
        && memberUnits(workspaceId).hasAny(onboardingRequestData(workspaceId, uid).get('provisionedUnitIds', []));
    }
    // Explicit field allowlist for a client-created onboarding request document.
    // Anything outside this list (approved, paymentVerifiedAtMs, codes,
    // approvedAtMs, diagnosis, patient fields, ...) is rejected by hasOnly().
    function onboardingRequestFieldAllowlist() {
      return request.resource.data.keys().hasOnly([
        'workspaceId','subscriberId','subscriberName','createdByName','status','method',
        'unitIds','amount','currency','paymentVerified','onboarding','requestType','institutionName','phone',
        'doctorsCount','clinicServices','unitDrafts','lineItems','submittedAtMs',
        'trialEligible','isRenewal','createdBy','createdByEmail',
        'createdAtMs','schemaVersion'
      ]);
    }
    // One allowlist for every client-created request document. `onboarding` is
    // allowed here and is pinned by the onboarding tail (onboarding == true,
    // deterministic id, empty unitIds) while the member tail requires it to be
    // false, so a member can never turn a request into an onboarding request.
    function requestFieldAllowlist() {
      return request.resource.data.keys().hasOnly([
        'workspaceId','subscriberId','subscriberName','createdByName','status','method',
        'unitIds','amount','currency','paymentVerified','onboarding','requestType','institutionName','phone',
        'doctorsCount','clinicServices','unitDrafts','lineItems','submittedAtMs','trialStartedAtMs',
        'trialEligible','isRenewal','createdBy','createdByEmail','createdAtMs','schemaVersion'
      ]);
    }
    function validRequestUnitDraft(draft) {
      return draft is map
        && draft.keys().hasOnly(['id','name','typeLabel','beds','receivesOperations'])
        && draft.keys().hasAll(['id','name','typeLabel','beds','receivesOperations'])
        && draft.id.matches('^[A-Za-z0-9_-]{1,128}$')
        && draft.name is string && draft.name.size() >= 2 && draft.name.size() <= 80
        && draft.typeLabel is string && draft.typeLabel.size() >= 1 && draft.typeLabel.size() <= 120
        && draft.beds is int && draft.beds >= 0 && draft.beds <= 200
        && draft.receivesOperations is bool;
    }
    function validRequestUnitDraftAt(index) {
      let drafts = request.resource.data.get('unitDrafts', []);
      return drafts.size() <= index || validRequestUnitDraft(drafts[index]);
    }
    function validRequestUnitDrafts() {
      let drafts = request.resource.data.get('unitDrafts', []);
      return drafts is list
        && drafts.size() <= 50
        && validRequestUnitDraftAt(0)
        && validRequestUnitDraftAt(1)
        && validRequestUnitDraftAt(2)
        && validRequestUnitDraftAt(3)
        && validRequestUnitDraftAt(4)
        && validRequestUnitDraftAt(5)
        && validRequestUnitDraftAt(6)
        && validRequestUnitDraftAt(7)
        && validRequestUnitDraftAt(8)
        && validRequestUnitDraftAt(9)
        && validRequestUnitDraftAt(10)
        && validRequestUnitDraftAt(11)
        && validRequestUnitDraftAt(12)
        && validRequestUnitDraftAt(13)
        && validRequestUnitDraftAt(14)
        && validRequestUnitDraftAt(15)
        && validRequestUnitDraftAt(16)
        && validRequestUnitDraftAt(17)
        && validRequestUnitDraftAt(18)
        && validRequestUnitDraftAt(19)
        && validRequestUnitDraftAt(20)
        && validRequestUnitDraftAt(21)
        && validRequestUnitDraftAt(22)
        && validRequestUnitDraftAt(23)
        && validRequestUnitDraftAt(24)
        && validRequestUnitDraftAt(25)
        && validRequestUnitDraftAt(26)
        && validRequestUnitDraftAt(27)
        && validRequestUnitDraftAt(28)
        && validRequestUnitDraftAt(29)
        && validRequestUnitDraftAt(30)
        && validRequestUnitDraftAt(31)
        && validRequestUnitDraftAt(32)
        && validRequestUnitDraftAt(33)
        && validRequestUnitDraftAt(34)
        && validRequestUnitDraftAt(35)
        && validRequestUnitDraftAt(36)
        && validRequestUnitDraftAt(37)
        && validRequestUnitDraftAt(38)
        && validRequestUnitDraftAt(39)
        && validRequestUnitDraftAt(40)
        && validRequestUnitDraftAt(41)
        && validRequestUnitDraftAt(42)
        && validRequestUnitDraftAt(43)
        && validRequestUnitDraftAt(44)
        && validRequestUnitDraftAt(45)
        && validRequestUnitDraftAt(46)
        && validRequestUnitDraftAt(47)
        && validRequestUnitDraftAt(48)
        && validRequestUnitDraftAt(49);
    }
    function validClinicService(value) {
      return value.matches('^.{1,120}$');
    }
    function validClinicServiceAt(index) {
      let services = request.resource.data.get('clinicServices', []);
      return services.size() <= index || validClinicService(services[index]);
    }
    function validRequestClinicServices() {
      let services = request.resource.data.get('clinicServices', []);
      return services is list
        && services.size() <= 20
        && validClinicServiceAt(0) && validClinicServiceAt(1) && validClinicServiceAt(2)
        && validClinicServiceAt(3) && validClinicServiceAt(4) && validClinicServiceAt(5)
        && validClinicServiceAt(6) && validClinicServiceAt(7) && validClinicServiceAt(8)
        && validClinicServiceAt(9) && validClinicServiceAt(10) && validClinicServiceAt(11)
        && validClinicServiceAt(12) && validClinicServiceAt(13) && validClinicServiceAt(14)
        && validClinicServiceAt(15) && validClinicServiceAt(16) && validClinicServiceAt(17)
        && validClinicServiceAt(18) && validClinicServiceAt(19);
    }
    function validRequestBaseFields() {
      let data = request.resource.data;
      return data.workspaceId is string
        && data.subscriberId is string
        && data.subscriberName is string && data.subscriberName.size() >= 1 && data.subscriberName.size() <= 200
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 200
        && data.requestType in ['department','clinic','both']
        && data.institutionName is string && data.institutionName.size() >= 2 && data.institutionName.size() <= 200
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40
        && data.method in ['instapay','visa']
        && data.currency in ['EGP','USD']
        && data.paymentVerified == false
        && data.createdBy == request.auth.uid
        && data.submittedAtMs > 0
        && data.createdAtMs > 0
        && data.schemaVersion == 1
        && data.trialEligible is bool
        && data.isRenewal is bool
        && data.status == 'pending'
        && request.resource.data.lineItems is list
        && request.resource.data.lineItems.size() <= 2;
    }
    function validRequestLineItem(item, area, quantity, currency, price) {
      return item is map
        && item.keys().hasOnly(['area','quantity','currency','unitPrice','subtotal'])
        && item.keys().hasAll(['area','quantity','currency','unitPrice','subtotal'])
        && item.area == area
        && item.quantity is int
        && item.quantity == quantity
        && item.currency == currency
        && item.unitPrice is int
        && item.unitPrice == price
        && item.subtotal is int
        && item.subtotal == quantity * price;
    }
    function validRequestPricing() {
      let drafts = request.resource.data.get('unitDrafts', []);
      let doctors = request.resource.data.get('doctorsCount', 0);
      let expectedCurrency = request.resource.data.method == 'instapay' ? 'EGP' : 'USD';
      let expectedPrice = request.resource.data.method == 'instapay' ? 500 : 20;
      let deptQuantity = drafts.size();
      let clinicQuantity = doctors;
      return doctors is int
        && doctors >= 0
        && doctors <= 200
        && request.resource.data.currency == expectedCurrency
        && request.resource.data.amount == (deptQuantity + clinicQuantity) * expectedPrice
        && (
          (deptQuantity > 0 && clinicQuantity > 0
            && request.resource.data.lineItems.size() == 2
            && validRequestLineItem(request.resource.data.lineItems[0], 'department', deptQuantity, expectedCurrency, expectedPrice)
            && validRequestLineItem(request.resource.data.lineItems[1], 'clinic', clinicQuantity, expectedCurrency, expectedPrice))
          || (deptQuantity > 0 && clinicQuantity == 0
            && request.resource.data.lineItems.size() == 1
            && validRequestLineItem(request.resource.data.lineItems[0], 'department', deptQuantity, expectedCurrency, expectedPrice))
          || (deptQuantity == 0 && clinicQuantity > 0
            && request.resource.data.lineItems.size() == 1
            && validRequestLineItem(request.resource.data.lineItems[0], 'clinic', clinicQuantity, expectedCurrency, expectedPrice))
        );
    }
    function validRequestScopeShape() {
      let type = request.resource.data.requestType;
      let unitCount = request.resource.data.get('unitDrafts', []).size();
      let doctors = request.resource.data.get('doctorsCount', 0);
      return (type == 'department' && unitCount > 0 && doctors == 0)
        || (type == 'clinic' && unitCount == 0 && doctors >= 1 && doctors <= 200)
        || (type == 'both' && unitCount > 0 && doctors >= 1 && doctors <= 200);
    }
    // -----------------------------------------------------------------------------
    // The rules engine enforces a hard budget of 1000 expressions per decision.
    // Evaluating the full type/pricing checks inside BOTH `... || ...` branches
    // blew that budget, so every genuine member request and every renewal was
    // rejected with "maximum of 1000 expressions to evaluate has been reached".
    // The base now runs exactly once and the tails hold only what differs.
    // Nothing was dropped: every check that existed before still runs.
    function validRequestDocumentBase(workspaceId) {
      return requestFieldAllowlist()
        && request.resource.data.keys().hasAll([
          'workspaceId','subscriberId','subscriberName','createdByName','status','method','unitIds',
          'amount','currency','paymentVerified','requestType','institutionName','phone','doctorsCount',
          'clinicServices','unitDrafts','lineItems','submittedAtMs','trialEligible',
          'isRenewal','createdBy','createdAtMs','schemaVersion'
        ])
        && validRequestBaseFields()
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.subscriberId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && validRequestScopeShape()
        && validRequestPricing();
    }
    // A member request: inside their own membership, trial clock, no onboarding.
    function validMemberRequestTail(workspaceId) {
      return request.resource.data.keys().hasAll(['trialStartedAtMs'])
        && request.resource.data.get('onboarding', false) == false
        && validRequestUnitDrafts()
        && validRequestClinicServices()
        && request.resource.data.unitIds is list
        && request.resource.data.unitIds.size() <= 50
        && request.resource.data.unitIds.size() == request.resource.data.get('unitDrafts', []).size()
        && request.resource.data.unitIds.toSet().size() == request.resource.data.unitIds.size()
        && request.resource.data.unitIds.hasOnly(memberUnits(workspaceId))
        && request.resource.data.trialStartedAtMs is int
        && request.resource.data.trialStartedAtMs > 0
        && request.resource.data.trialStartedAtMs <= request.time.toMillis();
    }
    // A brand-new account: its own workspace, ONE deterministic request id, no
    // unit claim at all (the drafts are a plan, not access), and it grants
    // nothing - the owner still decides.
    function validOnboardingRequestTail(workspaceId, requestId) {
      return onboardingWorkspace(workspaceId)
        && requestId == onboardingRequestId(request.auth.uid)
        && validRequestUnitDrafts()
        && validRequestClinicServices()
        && request.resource.data.keys().hasAll(['onboarding'])
        && request.resource.data.workspaceId == onboardingWorkspaceId(request.auth.uid)
        && request.resource.data.onboarding == true
        && request.resource.data.isRenewal == false
        && request.resource.data.get('unitIds', []) is list
        && request.resource.data.get('unitIds', []).size() == 0;
    }
    function teamPath(workspaceId) { return /databases/$(database)/documents/workspaces/$(workspaceId)/team/$(request.auth.uid); }
    function unitPath(workspaceId,unitId) { return /databases/$(database)/documents/workspaces/$(workspaceId)/units/$(unitId); }
    function unitExists(workspaceId,unitId) { return exists(unitPath(workspaceId,unitId)); }
    function unitData(workspaceId,unitId) { return get(unitPath(workspaceId,unitId)).data; }
    function unitLicensePath(workspaceId,unitId) { return /databases/$(database)/documents/workspaces/$(workspaceId)/unitLicenses/$(unitId); }
    function unitLicenseCodePath(workspaceId,codeHash) { return /databases/$(database)/documents/workspaces/$(workspaceId)/unitLicenseCodes/$(codeHash); }
    function activationRequestPath(requestId) { return /databases/$(database)/documents/unitActivationRequests/$(requestId); }
    function unitLicenseActive(workspaceId,unitId) {
      return exists(unitLicensePath(workspaceId,unitId))
        && get(unitLicensePath(workspaceId,unitId)).data.workspaceId == workspaceId
        && get(unitLicensePath(workspaceId,unitId)).data.unitId == unitId
        && get(unitLicensePath(workspaceId,unitId)).data.expiresAtMs is int
        && get(unitLicensePath(workspaceId,unitId)).data.expiresAtMs > request.time.toMillis();
    }
    function expectedLicenseExpiryMs(workspaceId,unitId) {
      return exists(unitLicensePath(workspaceId,unitId))
          && get(unitLicensePath(workspaceId,unitId)).data.expiresAtMs > request.time.toMillis()
        ? get(unitLicensePath(workspaceId,unitId)).data.expiresAtMs + 2592000000
        : request.time.toMillis() + 2592000000;
    }
    function validLicenseCodeRedemption(workspaceId,unitId) {
      return signedIn()
        && memberHasUnit(workspaceId,unitId)
        && resource.data.status == 'active'
        && resource.data.codeExpiresAtMs > request.time.toMillis()
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.unitId == unitId
        && request.resource.data.codeHash is string
        && request.resource.data.codeHash.size() == 64
        && request.resource.data.status == 'redeemed'
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.redeemedAtMs is int
        && request.resource.data.licenseExpiresAtMs is int
        && request.resource.data.licenseExpiresAtMs >= expectedLicenseExpiryMs(workspaceId,unitId) - 120000
        && request.resource.data.licenseExpiresAtMs <= expectedLicenseExpiryMs(workspaceId,unitId) + 120000;
    }
    function licenseWriteUsesRedeemedCode(workspaceId,unitId) {
      return memberHasUnit(workspaceId,unitId)
        && request.resource.data.activationCodeHash is string
        && existsAfter(unitLicenseCodePath(workspaceId,request.resource.data.activationCodeHash))
        && getAfter(unitLicenseCodePath(workspaceId,request.resource.data.activationCodeHash)).data.workspaceId == workspaceId
        && getAfter(unitLicenseCodePath(workspaceId,request.resource.data.activationCodeHash)).data.unitId == unitId
        && getAfter(unitLicenseCodePath(workspaceId,request.resource.data.activationCodeHash)).data.status == 'redeemed'
        && getAfter(unitLicenseCodePath(workspaceId,request.resource.data.activationCodeHash)).data.redeemedBy == request.auth.uid
        && getAfter(unitLicenseCodePath(workspaceId,request.resource.data.activationCodeHash)).data.licenseExpiresAtMs == request.resource.data.expiresAtMs;
    }
    function validOwnerInitialUnitLicense(workspaceId,unitId) {
      let activationRequestId = request.resource.data.get('activationRequestId','');
      return adminOf(workspaceId)
        && request.resource.data.keys().hasOnly(['workspaceId','unitId','issuedAtMs','expiresAtMs','updatedBy','schemaVersion','activationRequestId'])
        && request.resource.data.keys().hasAll(['workspaceId','unitId','issuedAtMs','expiresAtMs','updatedBy','schemaVersion'])
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.unitId == unitId
        && request.resource.data.issuedAtMs is int
        && request.resource.data.expiresAtMs == request.resource.data.issuedAtMs + 2592000000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.schemaVersion == 1
        && unitExists(workspaceId,unitId)
        && unitData(workspaceId,unitId).get('activationStatus','') == 'active'
        && (activationRequestId == ''
          ? unitData(workspaceId,unitId).get('createdBy','') == request.auth.uid
            && request.resource.data.issuedAtMs >= request.time.toMillis() - 120000
            && request.resource.data.issuedAtMs <= request.time.toMillis() + 120000
          : exists(activationRequestPath(activationRequestId))
            && get(activationRequestPath(activationRequestId)).data.requestId == activationRequestId
            && get(activationRequestPath(activationRequestId)).data.workspaceId == workspaceId
            && get(activationRequestPath(activationRequestId)).data.unitId == unitId
            && get(activationRequestPath(activationRequestId)).data.status == 'approving'
            && get(activationRequestPath(activationRequestId)).data.approvedBy == request.auth.uid
            && get(activationRequestPath(activationRequestId)).data.approvalStartedAtMs == request.resource.data.issuedAtMs);
    }
    // The owner reset client verifies live bed documents from the server; rules
    // constrain the write to an owner and an existing, non-deleted unit because
    // Firestore Rules cannot count a collection's bed documents.
    function validOwnerUnitLicenseReset(workspaceId,unitId) {
      return adminOf(workspaceId)
        && unitExists(workspaceId,unitId)
        && unitData(workspaceId,unitId).get('deleted',false) != true
        && !unitData(workspaceId,unitId).keys().hasAny(['deletedAt'])
        && request.resource.data.keys().hasOnly(['workspaceId','unitId','issuedAtMs','expiresAtMs','updatedBy','schemaVersion'])
        && request.resource.data.keys().hasAll(['workspaceId','unitId','issuedAtMs','expiresAtMs','updatedBy','schemaVersion'])
        && request.resource.data.workspaceId == workspaceId
        && request.resource.data.unitId == unitId
        && request.resource.data.issuedAtMs is int
        && request.resource.data.issuedAtMs >= request.time.toMillis() - 120000
        && request.resource.data.issuedAtMs <= request.time.toMillis() + 120000
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs >= request.time.toMillis() + 2592000000 - 120000
        && request.resource.data.expiresAtMs <= request.time.toMillis() + 2592000000 + 120000
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.schemaVersion == 1;
    }
    function validUnitActivationRequestCreate(requestId) {
      return signedIn()
        && request.resource.data.keys().hasOnly(['requestId','workspaceId','unitId','unitName','requestedBedCount','requestedBy','requestedByName','requestedAtMs','status','schemaVersion'])
        && request.resource.data.keys().hasAll(['requestId','workspaceId','unitId','unitName','requestedBedCount','requestedBy','requestedByName','requestedAtMs','status','schemaVersion'])
        && request.resource.data.requestId == requestId
        && request.resource.data.workspaceId is string
        && request.resource.data.unitId is string
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedAtMs is int
        && request.resource.data.requestedAtMs > 0
        && request.resource.data.requestedAtMs <= request.time.toMillis() + 120000
        && request.resource.data.requestedBedCount is int
        && request.resource.data.requestedBedCount >= 0
        && request.resource.data.requestedByName is string
        && request.resource.data.requestedByName.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.schemaVersion == 1
        && member(request.resource.data.workspaceId)
        && memberData(request.resource.data.workspaceId).get('role','') == 'department_admin'
        && (memberData(request.resource.data.workspaceId).get('unitId','') == request.resource.data.unitId
          || memberData(request.resource.data.workspaceId).get('unitIds', []).hasAny([request.resource.data.unitId]))
        && unitExists(request.resource.data.workspaceId,request.resource.data.unitId)
        && unitData(request.resource.data.workspaceId,request.resource.data.unitId).get('createdBy','') == request.auth.uid
        && unitData(request.resource.data.workspaceId,request.resource.data.unitId).get('activationStatus','') == 'pending'
        && unitData(request.resource.data.workspaceId,request.resource.data.unitId).totalBeds == request.resource.data.requestedBedCount;
    }

    // A member of a workspace only ever reaches the units listed on their own
    // membership (or on their team profile). Nothing here can be tricked into
    // reading a sibling unit.
    function memberHasUnit(workspaceId,unitId) {
      return member(workspaceId)
        && exists(teamPath(workspaceId))
        && get(teamPath(workspaceId)).data.status == 'active'
        && (
          get(teamPath(workspaceId)).data.get('assignedUnitIds', []).hasAny([unitId])
          || memberData(workspaceId).get('unitId','') == unitId
          || memberData(workspaceId).get('unitIds', []).hasAny([unitId])
        );
    }
    function unitMember(workspaceId,unitId) {
      return unitLicenseActive(workspaceId,unitId) && memberHasUnit(workspaceId,unitId);
    }
    function clinicalEditor(workspaceId,unitId) {
      return unitMember(workspaceId,unitId) && memberData(workspaceId).role == 'clinical_editor';
    }

    // The units a membership update ADDS. A join may add exactly ONE unit, and
    // the proof (an access code, an invite, or a unit the caller created) must
    // be for THAT unit. The unit the document already had may stay the primary
    // one, so the proof is never compared with the old unitId.
    function addedUnits() {
      return request.resource.data.unitIds.removeAll(resource.data.get('unitIds', []));
    }

    // The caller's own unit set (their membership row plus their active team
    // profile). The three sources are exactly the ones unitMember above trusts, so
    // the two can never disagree about which units belong to the caller.
    function memberUnits(workspaceId) {
      return memberData(workspaceId).get('unitIds', [])
        .concat([memberData(workspaceId).get('unitId','')])
        .concat(
          exists(teamPath(workspaceId)) && get(teamPath(workspaceId)).data.status == 'active'
            ? get(teamPath(workspaceId)).data.get('assignedUnitIds', [])
            : []
        );
    }

    // Hospital grouping is metadata above units, not a clinical access scope.
    // Keep its stored shape bounded and exact; a hospital can reference at most
    // 200 distinct unit ids, matching the bounded Firestore document contract.
    function validHospitalUnitIds(unitIds) {
      return unitIds is list
        && unitIds.size() <= 200
        && unitIds.toSet().size() == unitIds.size();
    }
    function validHospitalDocument(data, hospitalId) {
      return data is map
        && data.keys().hasAll([
          'id','name','createdBy','createdAtMs','updatedAtMs','unitIds','schemaVersion'
        ])
        && data.keys().hasOnly([
          'id','name','createdBy','createdAtMs','updatedAtMs','unitIds','schemaVersion'
        ])
        && data.id is string
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.id.matches('^[A-Za-z0-9_-]{1,128}$')
        && data.id == hospitalId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.createdBy is string
        && data.createdBy.size() >= 1
        && data.createdBy.size() <= 128
        && data.createdAtMs is int
        && data.createdAtMs > 0
        && data.updatedAtMs is int
        && data.updatedAtMs >= data.createdAtMs
        && validHospitalUnitIds(data.unitIds)
        && data.schemaVersion is int
        && data.schemaVersion == 1;
    }

    // True when the caller belongs to ANY of the supplied units. The list comes
    // from a patient document's unitIds, so this is what makes one shared clinical
    // file visible to the second unit - and only to units the caller is really in.
    // A legacy document without unitIds yields an empty list and therefore false.
    function unitMemberAny(workspaceId,unitIds) {
      return member(workspaceId)
        && unitLicenseActive(workspaceId,memberData(workspaceId).get('unitId',''))
        && exists(teamPath(workspaceId))
        && get(teamPath(workspaceId)).data.status == 'active'
        && (
          get(teamPath(workspaceId)).data.get('assignedUnitIds', []).hasAny(unitIds)
          || memberData(workspaceId).get('unitIds', []).hasAny(unitIds)
          || unitIds.hasAny([memberData(workspaceId).get('unitId','')])
        );
    }

    // Sharing a file is additive only: every unit an update ADDS to a patient's
    // unitIds must be one of the caller's own units, and the patient's physical
    // unit must stay on the list. Removing units stays with the primary unit's
    // editor. A document that carries no unitIds yet (legacy) is left untouched.
    function sharedUnitsWithin(workspaceId) {
      return !request.resource.data.keys().hasAny(['unitIds'])
        || ( request.resource.data.unitIds.hasAny([request.resource.data.unitId])
             && request.resource.data.unitIds.removeAll(resource.data.get('unitIds', [])).hasOnly(memberUnits(workspaceId)) );
    }

    // Clinical titles a member may pick for themselves. 'consultant' is NOT a
    // stored title: it is the unit's single consultant slot
    // (units/{unitId}.consultantUid), so exactly one person can hold it per unit
    // and only the owner can clear it.
    function selfClinicalRole(role) { return role in ['nurse','resident','specialist']; }

    // -----------------------------------------------------------------------------
    // A clinic subscription has no department unit, so a clinic-only request has
    // an empty unitIds list. That case gets its own, deliberately narrow branch:
    // the request type must be exactly 'clinic', the doctor count must be a real
    // 1-200 seat count, and the amount must be the published 30-day price
    // (EGP 500 per doctor on InstaPay, USD 20 per doctor on Visa) in the currency
    // that method implies. Everything else is already checked by the caller of
    // this helper (workspace, subscriber, pending status, method, payment flag).
    function clinicOnlyRequest() {
      return request.resource.data.get('unitIds', []).size() == 0
        && request.resource.data.get('requestType', '') == 'clinic'
        && request.resource.data.doctorsCount is int
        && request.resource.data.doctorsCount >= 1
        && request.resource.data.doctorsCount <= 200
        && request.resource.data.get('clinicServices', []).size() <= 20
        && request.resource.data.get('phone', '') is string
        && request.resource.data.get('phone', '').size() >= 7
        && request.resource.data.get('institutionName', '') is string
        && request.resource.data.get('institutionName', '').size() >= 2
        && (
          ( request.resource.data.method == 'instapay'
            && request.resource.data.get('currency', '') == 'EGP'
            && request.resource.data.amount == request.resource.data.doctorsCount * 500 )
          || ( request.resource.data.method == 'visa'
            && request.resource.data.get('currency', '') == 'USD'
            && request.resource.data.amount == request.resource.data.doctorsCount * 20 )
        );
    }

    // -----------------------------------------------------------------------------
    function accessCodePath(hash) { return /databases/$(database)/documents/accessCodes/$(hash); }
    function accessCodeExists(hash) { return hash != '' && exists(accessCodePath(hash)); }
    function accessCodeData(hash) { return get(accessCodePath(hash)).data; }
    function validAccessCode(hash, workspaceId) {
      return signedIn() && accessCodeExists(hash)
        && accessCodeData(hash).active == true
        && accessCodeData(hash).workspaceId == workspaceId;
    }
    // The first account can join an onboarding workspace only after the owner
    // published a complete, payment-verified approval. The code itself remains
    // the membership proof; this exception only permits the non-clinical join
    // bootstrap while the trial clock is still absent.
    function onboardingApprovedJoin(workspaceId, uid, unitId, hash) {
      return signedIn()
        && request.auth.uid == uid
        && onboardingProvisioningComplete(workspaceId, uid)
        && onboardingRequestData(workspaceId, uid).get('provisionedUnitIds', []).hasAny([unitId])
        && validAccessCode(hash, workspaceId)
        && accessCodeData(hash).unitId == unitId
        && accessCodeData(hash).get('onboardingRequestId', '') == onboardingRequestId(uid);
    }

    // -----------------------------------------------------------------------------
    // The top-level /invites/{hash} document is a routing index only (it tells a
    // signed-in account which workspace and unit a code belongs to). The
    // authoritative state lives in workspaces/{ws}/invites/{hash}.
    function invitePath(workspaceId,inviteId) { return /databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(inviteId); }
    function inviteExists(workspaceId,inviteId) { return inviteId != '' && exists(invitePath(workspaceId,inviteId)); }
    function inviteData(workspaceId,inviteId) { return get(invitePath(workspaceId,inviteId)).data; }
    // A redeemed invite is bound to the account that burned it, so one code can
    // never enrol a second person, and an expired or revoked code is dead.
    function redeemedInvite(workspaceId, inviteId, unitId) {
      return inviteExists(workspaceId, inviteId)
        && inviteData(workspaceId, inviteId).used == true
        && inviteData(workspaceId, inviteId).usedBy == request.auth.uid
        && inviteData(workspaceId, inviteId).unitId == unitId
        && inviteData(workspaceId, inviteId).revoked != true;
    }

    // -----------------------------------------------------------------------------
    // Stored in milliseconds so the rules and every client agree on the type.
    function subPath(workspaceId) { return /databases/$(database)/documents/workspaces/$(workspaceId)/subscription/current; }
    function subExists(workspaceId) { return exists(subPath(workspaceId)); }
    function subData(workspaceId) { return get(subPath(workspaceId)).data; }
    // Workspaces with no subscription document are grandfathered: nothing locks
    // until a clock is explicitly created. Once graceEndsAtMs has passed the
    // whole workspace turns read-only for everyone except the platform owner.
    function subActive(workspaceId) {
      return !subExists(workspaceId)
        || !subData(workspaceId).keys().hasAny(['graceEndsAtMs'])
        || subData(workspaceId).graceEndsAtMs > request.time.toMillis();
    }
    // Write authorization is additionally constrained by the path's unitMember
    // check. A workspace-level clock would lock active sibling units, so it is
    // intentionally no longer consulted here.
    function canWrite(workspaceId) { return adminOf(workspaceId) || signedIn(); }

    // -----------------------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      // Bed and patient records that lived under /users/{uid} before the
      // workspace migration. Only their own account may read them.
      match /units/{unitId} { allow get, list: if signedIn() && request.auth.uid == uid; }
      match /beds/{bedId} { allow get, list: if signedIn() && request.auth.uid == uid; }
      match /patients/{patientId} { allow get, list: if signedIn() && request.auth.uid == uid; }
      // Private request ids are bounded at the rules boundary, not just by the
      // client helper. A user's private index is never listable by anyone.
      match /subscriptionIndex/{documentId} {
        allow get: if signedIn() && request.auth.uid == uid && documentId == 'current';
        allow list: if false;
        allow create, update: if signedIn() && request.auth.uid == uid && documentId == 'current'
          && request.resource.data.keys().hasOnly(['requestIds','workspaceId','updatedAtMs','schemaVersion'])
          && request.resource.data.keys().hasAll(['requestIds','workspaceId','updatedAtMs','schemaVersion'])
          && request.resource.data.requestIds is list
          && request.resource.data.requestIds.size() <= 100
          && request.resource.data.workspaceId is string
          && (request.resource.data.workspaceId == 'cardiovault_master_workspace'
              || request.resource.data.workspaceId.matches('^ws_[A-Za-z0-9_-]{8,64}$')
              || request.resource.data.workspaceId == onboardingWorkspaceId(uid))
          && request.resource.data.updatedAtMs is int
          && request.resource.data.updatedAtMs > 0
          && request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion == 1;
        allow delete: if signedIn() && request.auth.uid == uid && documentId == 'current';
      }
    }

    // -----------------------------------------------------------------------------
    match /accessCodes/{hash} {
      // Looked up by SHA-256 hash. A signed-in account may read a code so the
      // redemption flow can validate it; only the owner writes codes.
      allow get: if signedIn();
      allow create: if adminOf(request.resource.data.workspaceId);
      allow update, delete: if adminOf(resource.data.workspaceId);
    }

    // -----------------------------------------------------------------------------
    match /invites/{inviteId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if canWrite(request.resource.data.workspaceId)
        && unitMember(request.resource.data.workspaceId, request.resource.data.unitId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAtMs > request.time.toMillis();
      allow update, delete: if adminOf(resource.data.workspaceId) || request.auth.uid == resource.data.createdBy;
    }

    // -----------------------------------------------------------------------------
    // A doctor can work in more than one team with the same Google account. The
    // index only records WHICH teams exist for this account - it grants nothing:
    // opening a team still needs a real membership document, exactly as before.
    match /userWorkspaces/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
      match /workspaces/{workspaceId} {
        // Your own index, and only the teams you are really a member of.
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(memberPath(workspaceId))
          && get(memberPath(workspaceId)).data.active != false;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // -----------------------------------------------------------------------------
    // One document per platform owner holding presentation-only preferences
    // (today: which unit cards the owner hides on their own dashboard). It grants
    // nothing: no unit is deleted, no membership is changed, no subscription
    // field is derived from it, and a hidden unit stays fully readable for every
    // account that could read it before. Only the platform owner can read or
    // write their own document.
    match /ownerPreferences/{uid} {
      allow get: if signedIn() && request.auth.uid == uid && platformOwner();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid && platformOwner()
        && request.resource.data.hiddenUnitIds is list
        && request.resource.data.hiddenUnitIds.size() <= 200;
      allow delete: if signedIn() && request.auth.uid == uid && platformOwner();
    }

    // Onboarding discovery index: one tiny document per brand-new account, which
    // points the platform owner's panel at the customer workspace that account
    // created for itself. It carries no clinical data, no payment proof and no
    // permission - it only answers "which new workspaces have a request to
    // review". The owner may read and list it; an account may only write its own,
    // and only while it really created that workspace.
    match /onboardingIndex/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || platformOwner());
      allow list: if platformOwner();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'workspaceId','requestId','submittedAtMs','subscriberName','institutionName','schemaVersion','updatedAtMs'
        ])
        && request.resource.data.workspaceId is string
        && request.resource.data.workspaceId == onboardingWorkspaceId(uid)
        && workspaceCreatedByCaller(request.resource.data.workspaceId)
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() <= 160
        && request.resource.data.requestId == onboardingRequestId(uid)
        && request.resource.data.submittedAtMs is int
        && request.resource.data.submittedAtMs > 0
        && request.resource.data.updatedAtMs is int
        && request.resource.data.updatedAtMs > 0
        && request.resource.data.subscriberName is string
        && request.resource.data.subscriberName.size() >= 1
        && request.resource.data.subscriberName.size() <= 200
        && request.resource.data.institutionName is string
        && request.resource.data.institutionName.size() >= 2
        && request.resource.data.institutionName.size() <= 200
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1
        // Explicit field allowlist: only the fields the owner-discovery index
        // actually needs. This denies phone, amount, codes, paymentVerified and
        // any diagnosis/patient fields by construction.
        && request.resource.data.keys().hasOnly([
          'workspaceId','requestId','submittedAtMs','subscriberName','institutionName',
          'schemaVersion','updatedAtMs'
        ]);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Raw Unit Access Codes must not be placed in the customer-readable request
    // until the owner has completed provisioning and publishes approval. This
    // owner-only scratch document makes provisioning retries deterministic
    // without leaking a usable membership code to a pending requester.
    match /onboardingProvisioning/{uid} {
      allow get: if platformOwner();
      allow list: if false;
      allow create, update: if platformOwner()
        && request.resource.data.keys().hasAll([
          'workspaceId','requestId','selectionKey','provisionedUnitIds','unitAccessCodes','updatedAtMs','schemaVersion'
        ])
        && request.resource.data.workspaceId == onboardingWorkspaceId(uid)
        && request.resource.data.requestId == onboardingRequestId(uid)
        && request.resource.data.selectionKey is string
        && request.resource.data.selectionKey.size() <= 512
        && request.resource.data.provisionedUnitIds is list
        && request.resource.data.provisionedUnitIds.size() <= 51
        && request.resource.data.unitAccessCodes is list
        && request.resource.data.unitAccessCodes.size() <= 51
        && request.resource.data.updatedAtMs is int
        && request.resource.data.updatedAtMs > 0
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1
        && request.resource.data.keys().hasOnly([
          'workspaceId','requestId','selectionKey','provisionedUnitIds','unitAccessCodes',
          'updatedAtMs','schemaVersion'
        ]);
      allow delete: if platformOwner();
    }

    // -----------------------------------------------------------------------------
    match /workspaces/{workspaceId} {
      // Any signed-in account may bootstrap a customer team workspace, but the
      // document may never claim an owner: ownership is the platform owner's
      // alone. createdBy is recorded for the audit trail only, and creating a
      // workspace grants no access to it.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && !request.resource.data.keys().hasAny(['ownerUid', 'ownerEmail'])
        && (
          (workspaceId == onboardingWorkspaceId(request.auth.uid)
            && request.resource.data.keys().hasAll(['createdBy','name','schemaVersion','createdAt','onboarding'])
            && request.resource.data.keys().hasOnly(['createdBy','createdByEmail','name','schemaVersion','createdAt','onboarding'])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 200
            && (!request.resource.data.keys().hasAny(['createdByEmail'])
                || (request.resource.data.createdByEmail is string && request.resource.data.createdByEmail.size() <= 320))
            && request.resource.data.schemaVersion is int
            && request.resource.data.schemaVersion == 13
            && request.resource.data.createdAt is string
            && request.resource.data.createdAt.size() <= 40
            && request.resource.data.onboarding == true)
          || (workspaceId != onboardingWorkspaceId(request.auth.uid)
              && (workspaceId == 'cardiovault_master_workspace' || workspaceId.matches('^ws_[A-Za-z0-9_-]{8,64}$')))
        );
      allow get, update, delete: if adminOf(workspaceId);
      allow get: if member(workspaceId)
        // The account that bootstrapped this workspace must be able to read it
        // back (a retry has to know whether it already exists). It grants no
        // access to anything inside the workspace: those rules still demand a
        // membership.
        || workspaceCreatedByCaller(workspaceId);

      // -----------------------------------------------------------------------------
      match /members/{uid} {
        allow get: if adminOf(workspaceId) || (signedIn() && request.auth.uid == uid);
        allow list: if adminOf(workspaceId);

        // First join: the unit must be granted by a live access code or by an
        // invite this account already burned. A membership is always born with
        // exactly the one unit it was granted.
        allow create: if (canWrite(workspaceId) && signedIn() && request.auth.uid == uid
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.unitIds.hasOnly([request.resource.data.unitId])
          && request.resource.data.unitIds.hasAny([request.resource.data.unitId])
          && request.resource.data.get('clinicalRoles', {}).keys().hasOnly(request.resource.data.unitIds)
          && request.resource.data.get('clinicalRoles', {}).values().hasOnly(['nurse','resident','specialist'])
          && (
            ( validAccessCode(request.resource.data.get('accessCodeHash',''), workspaceId)
              && accessCodeData(request.resource.data.get('accessCodeHash','')).unitId == request.resource.data.unitId
              && request.resource.data.role == accessCodeData(request.resource.data.get('accessCodeHash','')).get('role','clinical_editor') )
            || ( redeemedInvite(workspaceId, request.resource.data.get('inviteId',''), request.resource.data.unitId)
              && request.resource.data.role == inviteData(workspaceId, request.resource.data.get('inviteId','')).role )
          )) || (
          // A first-run customer may join only the approved units named in the
          // owner's completed request. This bootstrap creates membership only
          // through the corresponding Unit Access Code, never a subscription code.
          onboardingApprovedJoin(workspaceId, uid, request.resource.data.get('unitId',''), request.resource.data.get('accessCodeHash',''))
          && request.resource.data.keys().hasOnly([
            'uid','workspaceId','unitId','unitIds','role','accessCodeHash','accessCodeHashes',
            'active','forceReauth','joinedAt','updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'uid','workspaceId','unitId','unitIds','role','accessCodeHash','accessCodeHashes',
            'active','forceReauth','joinedAt','updatedAt'
          ])
          && request.resource.data.uid == uid
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.unitId is string
          && request.resource.data.unitIds is list
          && request.resource.data.unitIds.size() == 1
          && request.resource.data.unitIds.hasOnly([request.resource.data.unitId])
          && request.resource.data.accessCodeHash is string
          && request.resource.data.accessCodeHash.matches('^[A-Fa-f0-9]{64}$')
          && request.resource.data.accessCodeHashes is list
          && request.resource.data.accessCodeHashes.size() == 1
          && request.resource.data.accessCodeHashes.hasAny([request.resource.data.accessCodeHash])
          && request.resource.data.role == accessCodeData(request.resource.data.accessCodeHash).get('role','clinical_editor')
          && request.resource.data.role in ['clinical_editor','view_only']
          && request.resource.data.active == true
          && request.resource.data.forceReauth == false
          && request.resource.data.joinedAt is string
          && request.resource.data.joinedAt.size() <= 40
          && request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40
        );

        // Membership changes (role, unit list, activation) are administrative:
        // the platform owner alone. A member may only ADD the unit a code, an
        // invite, or a unit they just created grants them, and may only retitle
        // themselves inside units they already belong to. Unit access is never
        // removed by the member, and the workspace-wide access level never changes
        // through a join.
        allow update: if canWrite(workspaceId) && (
          adminOf(workspaceId) ||
          (signedIn() && request.auth.uid == uid
           && request.resource.data.uid == request.auth.uid
           && request.resource.data.workspaceId == workspaceId
           && (
             (
               // The proof must cover the unit this update ADDS - not the unit the
               // document already had. A doctor who joins a second unit keeps his
               // first unit as the primary one, so the old check (proof == unitId)
               // refused that join for the wrong reason.
               (
                 addedUnits().size() == 1
                 && (
                   ( validAccessCode(request.resource.data.get('accessCodeHash',''), workspaceId)
                     && accessCodeData(request.resource.data.get('accessCodeHash','')).unitId == addedUnits()[0] )
                   || ( redeemedInvite(workspaceId, request.resource.data.get('inviteId',''), addedUnits()[0]) )
                   // Creating a unit adds that unit to the creator's own membership.
                   || ( unitExists(workspaceId, addedUnits()[0])
                        && unitData(workspaceId, addedUnits()[0]).get('createdBy','') == request.auth.uid )
                 )
               )
               // Nothing new is granted: the doctor simply confirms a unit he
               // already has (re-entering the access code he used before).
               || (
                 addedUnits().size() == 0
                 && (
                   ( validAccessCode(request.resource.data.get('accessCodeHash',''), workspaceId)
                     && request.resource.data.get('unitIds',[]).hasAny([accessCodeData(request.resource.data.get('accessCodeHash','')).unitId]) )
                   || ( redeemedInvite(workspaceId, request.resource.data.get('inviteId',''), request.resource.data.unitId) )
                 )
               )
             )
             && request.resource.data.role == resource.data.role
             && request.resource.data.unitIds.hasAny([request.resource.data.unitId])
             && request.resource.data.unitIds.hasAll(resource.data.get('unitIds', []))
             && request.resource.data.get('clinicalRoles', {}).keys().hasOnly(request.resource.data.unitIds)
             && request.resource.data.get('clinicalRoles', {}).values().hasOnly(['nurse','resident','specialist'])
             && request.resource.data.active == true
             && request.resource.data.forceReauth == false
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unitId','unitIds','role','clinicalRoles','accessCodeHash','accessCodeHashes','inviteId','inviteIds','active','forceReauth','joinedAt','updatedAt'])
           )
           || (
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clinicalRoles','updatedAt'])
             && request.resource.data.get('clinicalRoles', {}).keys().hasOnly(resource.data.get('unitIds', []))
             && request.resource.data.get('clinicalRoles', {}).values().hasOnly(['nurse','resident','specialist'])
           )
          )
        );

        allow delete: if adminOf(workspaceId);
      }

      // Per-unit access receipt (used by the revoke flow). The clinical title
      // itself lives on the membership document, not here.
      match /members/{uid}/units/{unitId} {
        allow get, list: if adminOf(workspaceId) || (signedIn() && request.auth.uid == uid);
        allow create, update: if (canWrite(workspaceId) && (
          adminOf(workspaceId) ||
          (signedIn() && request.auth.uid == uid
           && request.resource.data.uid == request.auth.uid
           && request.resource.data.unitId == unitId
           && ( validAccessCode(request.resource.data.get('accessCodeHash',''), workspaceId)
                 || redeemedInvite(workspaceId, request.resource.data.get('inviteId',''), unitId) ))))
          || onboardingApprovedJoin(workspaceId, uid, unitId, request.resource.data.get('accessCodeHash',''))
             && request.resource.data.uid == uid
             && request.resource.data.unitId == unitId;
        allow delete: if adminOf(workspaceId);
      }

      match /accessCodes/{hash} { allow read, write: if adminOf(workspaceId); }

      // -----------------------------------------------------------------------------
      // Any member of a unit may invite somebody into that unit. The code is a
      // hash document id, carries a hard expiry, and is burned exactly once.
      match /invites/{inviteId} {
        allow get: if signedIn();
        // List is evaluated per document: a member only ever sees the invites
        // they issued themselves.
        allow list: if adminOf(workspaceId) || (signedIn() && request.auth.uid == resource.data.createdBy);
        allow create: if canWrite(workspaceId) && unitMember(workspaceId, request.resource.data.unitId)
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.used == false
          && request.resource.data.get('revoked', false) == false
          && request.resource.data.role in ['clinical_editor','view_only']
          && request.resource.data.get('clinicalRole','resident') in ['nurse','resident','specialist','consultant']
          && request.resource.data.expiresAtMs > request.time.toMillis()
          && request.resource.data.expiresAtMs <= request.time.toMillis() + 2592000000
          // A consultant invite is only meaningful while the unit's single
          // consultant slot is still free.
          && ( request.resource.data.get('clinicalRole','resident') != 'consultant'
               || !unitExists(workspaceId, request.resource.data.unitId)
               || unitData(workspaceId, request.resource.data.unitId).get('consultantUid','') == '' );
        allow update: if (
            // the invited person burns the code, once
            signedIn() && resource.data.used == false && resource.data.get('revoked', false) != true
            && request.resource.data.used == true
            && request.resource.data.usedBy == request.auth.uid
            && resource.data.expiresAtMs > request.time.toMillis()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used','usedBy','usedAt'])
          ) || (
            // the issuer or the owner withdraws it
            canWrite(workspaceId)
            && (adminOf(workspaceId) || request.auth.uid == resource.data.createdBy)
            && resource.data.used == false
            && request.resource.data.revoked == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked','revokedAt'])
          );
        allow delete: if adminOf(workspaceId) || (canWrite(workspaceId) && request.auth.uid == resource.data.createdBy);
      }

      // -----------------------------------------------------------------------------
      // A colleague's profile is theirs alone. The platform owner may read any
      // profile; an account may always read its own. Nobody may enumerate the
      // directory: the only team list a member gets is the roster of a unit they
      // belong to (below), never every account in the workspace.
      match /team/{uid} {
        allow get: if adminOf(workspaceId) || (signedIn() && request.auth.uid == uid);
        allow list: if adminOf(workspaceId);
        // A member may self-create only a non-privileged clinical profile.
        allow create: if (canWrite(workspaceId) && (
          adminOf(workspaceId) ||
          (signedIn() && request.auth.uid == uid
           && request.resource.data.uid == request.auth.uid
           && request.resource.data.workspaceId == workspaceId
           && request.resource.data.departmentId == 'dept-cardiology'
           && request.resource.data.status == 'active'
           && member(workspaceId)
           // The unit list on a team profile is also an access path (unitMember
           // reads it), so a member may only echo units they actually belong to.
           && request.resource.data.get('assignedUnitIds', []).hasOnly(memberData(workspaceId).get('unitIds', []))
           && (request.resource.data.role == 'pending' || request.resource.data.role in ['nurse','resident','specialist']))))
          || (onboardingMemberBootstrap(workspaceId, uid)
              && request.resource.data.uid == uid
              && request.resource.data.workspaceId == workspaceId
              && request.resource.data.departmentId == 'dept-cardiology'
              && request.resource.data.status == 'active'
              && request.resource.data.get('assignedUnitIds', []).size() > 0
              && request.resource.data.get('assignedUnitIds', []).hasOnly(memberUnits(workspaceId))
              && (request.resource.data.role == 'pending' || selfClinicalRole(request.resource.data.role)));

        // A member may update only their own clinical profile fields. Role
        // management and unit assignment belong to the platform owner; the old
        // 'consultant' branch let any member promote themselves and then rewrite
        // other memberships, so it is gone.
        allow update: if (canWrite(workspaceId) && (
          adminOf(workspaceId) ||
          (signedIn() && request.auth.uid == uid
           && resource.data.uid == request.auth.uid
           && request.resource.data.uid == request.auth.uid
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','role','roleSelectedAt','updatedAt'])
           && selfClinicalRole(request.resource.data.role))))
          || (onboardingMemberBootstrap(workspaceId, uid)
              && resource.data.uid == uid
              && request.resource.data.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','role','roleSelectedAt','updatedAt'])
              && selfClinicalRole(request.resource.data.role));

        allow delete: if adminOf(workspaceId);
      }

      // -----------------------------------------------------------------------------
      match /hospitals/{hospitalId} {
        allow get: if adminOf(workspaceId) || (member(workspaceId) && resource.data.get('unitIds',[]).hasAny(memberUnits(workspaceId)));
        allow list: if adminOf(workspaceId);
        allow create: if adminOf(workspaceId) && request.resource.data.id == hospitalId && request.resource.data.name.size() <= 120 && request.resource.data.unitIds == [];
        allow update: if adminOf(workspaceId) && request.resource.data.id == resource.data.id && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAtMs == resource.data.createdAtMs;
        allow delete: if adminOf(workspaceId);
      }

      // -----------------------------------------------------------------------------
      // Creating a unit makes you that unit's consultant and freezes the unit's
      // capacity once it is locked: only the owner changes bed count afterwards.
      match /units/{unitId} {
        // The creator may read the unit back before their membership catches up.
        // Unit metadata is not clinical data: an assigned member may read it
        // even while the unit is pending/expired so setup state can be shown.
        // Clinical collections still require unitMember() and an active license.
        allow get: if adminOf(workspaceId) || memberHasUnit(workspaceId,unitId) || (signedIn() && resource.data.get('createdBy','') == request.auth.uid);
        allow list: if adminOf(workspaceId);

        allow create: if canWrite(workspaceId) && (
          adminOf(workspaceId) ||
          (member(workspaceId)
           && memberData(workspaceId).get('role','') == 'department_admin'
           // Unit-to-hospital assignment is owner-managed. A member-created unit
           // must not smuggle a hospitalId into its initial document.
           && !request.resource.data.keys().hasAny(['hospitalId'])
           && request.resource.data.createdBy == request.auth.uid
           && request.resource.data.consultantUid == request.auth.uid
           && request.resource.data.get('activationStatus','pending') == 'pending'
           && request.resource.data.get('capacityLocked', false) == false
           && request.resource.data.createdAtMs <= request.time.toMillis()));

        allow update: if canWrite(workspaceId) && (
          adminOf(workspaceId) ||
           (unitMember(workspaceId, unitId) && (
            // claim the unit's empty consultant slot
            ( resource.data.get('consultantUid','') == ''
              && request.resource.data.get('consultantUid','') == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consultantUid','updatedAt']) )
            // the unit's consultant edits presentation only: never the bed
            // count, never somebody else's consultant slot
            || ( resource.data.get('consultantUid','') == request.auth.uid
                 && request.resource.data.get('consultantUid','') == request.auth.uid
                 && request.resource.data.get('totalBeds', 0) == resource.data.get('totalBeds', 0)
                 && ( !request.resource.data.diff(resource.data).affectedKeys().hasAny(['capacityLocked'])
                      || request.resource.data.capacityLocked == true )
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','type','features','notes','consultantUid','capacityLocked','updatedAt']) )
           ))
           || (resource.data.get('activationStatus','') == 'pending'
               && resource.data.get('createdBy','') == request.auth.uid
               && request.resource.data.capacityLocked == true
               && request.resource.data.get('totalBeds',0) == resource.data.get('totalBeds',0)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['capacityLocked','updatedAt'])));

        allow delete: if adminOf(workspaceId);
      }

      // -----------------------------------------------------------------------------
      // The platform owner may enumerate and manage hospital metadata. Members
      // can only fetch a known hospital id after one of its unitIds intersects
      // the exact unit set already granted by their membership/team profile.
      // Members cannot list this collection; the app loads their hospitals by
      // direct gets from those authorized units.
      match /hospitals/{hospitalId} {
        allow get: if adminOf(workspaceId)
          || (member(workspaceId)
              && resource.data.get('unitIds', []) is list
              && resource.data.get('unitIds', []).hasAny(memberUnits(workspaceId)));
        allow list: if adminOf(workspaceId);

        allow create: if adminOf(workspaceId)
          && validHospitalDocument(request.resource.data, hospitalId)
          && request.resource.data.createdBy == request.auth.uid;

        // The current client updates only the unitIds membership list and its
        // timestamp. Identity, name, creator, creation time and schema version
        // remain unchanged; malformed existing documents cannot be repaired
        // through a partial merge that bypasses schema validation.
        allow update: if adminOf(workspaceId)
          && validHospitalDocument(resource.data, hospitalId)
          && validHospitalDocument(request.resource.data, hospitalId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.name == resource.data.name
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAtMs == resource.data.createdAtMs
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unitIds','updatedAtMs']);

        allow delete: if adminOf(workspaceId);
      }

      // -----------------------------------------------------------------------------
      // Who works in THIS unit, one document per (unit, member). It is the only
      // directory a non-owner may read, so a member of Unit A can never learn who
      // works in Unit B. A member may write only their own entry and only inside a
      // unit they already belong to; unit membership management is the owner's.
      // `uid` must equal the document id on every write, so the id and the payload
      // can never disagree.
      match /units/{unitId}/roster/{uid} {
        allow get, list: if adminOf(workspaceId) || unitMember(workspaceId, unitId) || (signedIn() && request.auth.uid == uid);
        allow create, update: if (canWrite(workspaceId)
          && request.resource.data.uid == uid
          && ( adminOf(workspaceId)
               || (signedIn() && request.auth.uid == uid && unitMember(workspaceId, unitId)) ))
          || (onboardingMemberBootstrap(workspaceId, uid)
              && request.resource.data.uid == uid
              && request.auth.uid == uid
              && unitMember(workspaceId, unitId));
        allow delete: if adminOf(workspaceId);
      }

      // -----------------------------------------------------------------------------
      // Occupancy changes are clinical acts. Creating or deleting a bed changes
      // the unit's capacity, so only the owner may do it after the unit's
      // provisioning window closed (or after its consultant locked it).
      match /beds/{bedId} {
        allow get: if adminOf(workspaceId) || unitMember(workspaceId,resource.data.get('unitId','')) || unitMemberAny(workspaceId,resource.data.get('unitIds', [])) || (signedIn() && unitExists(workspaceId,resource.data.get('unitId','')) && unitData(workspaceId,resource.data.get('unitId','')).get('activationStatus','') == 'pending' && unitData(workspaceId,resource.data.get('unitId','')).get('createdBy','') == request.auth.uid && !resource.data.keys().hasAny(['patientId']));
        allow list: if adminOf(workspaceId) || unitMember(workspaceId,resource.data.get('unitId','')) || unitMemberAny(workspaceId,resource.data.get('unitIds', [])) || (signedIn() && unitExists(workspaceId,resource.data.get('unitId','')) && unitData(workspaceId,resource.data.get('unitId','')).get('activationStatus','') == 'pending' && unitData(workspaceId,resource.data.get('unitId','')).get('createdBy','') == request.auth.uid && !resource.data.keys().hasAny(['patientId']));

        allow create: if canWrite(workspaceId) && (
          adminOf(workspaceId) ||
          ( unitExists(workspaceId, request.resource.data.unitId)
            && unitData(workspaceId, request.resource.data.unitId).get('consultantUid','') == request.auth.uid
            && unitData(workspaceId, request.resource.data.unitId).get('createdBy','') == request.auth.uid
            && unitData(workspaceId, request.resource.data.unitId).get('capacityLocked', false) != true
            && request.time.toMillis() < unitData(workspaceId, request.resource.data.unitId).get('createdAtMs', 0) + 3600000 ));

        allow delete: if canWrite(workspaceId) && (
          adminOf(workspaceId) ||
          ( unitExists(workspaceId, resource.data.unitId)
            && unitData(workspaceId, resource.data.unitId).get('consultantUid','') == request.auth.uid
            && unitData(workspaceId, resource.data.unitId).get('createdBy','') == request.auth.uid
            && unitData(workspaceId, resource.data.unitId).get('capacityLocked', false) != true
            && request.time.toMillis() < unitData(workspaceId, resource.data.unitId).get('createdAtMs', 0) + 3600000 ));

        allow update: if canWrite(workspaceId) && (
          adminOf(workspaceId) ||
          ( clinicalEditor(workspaceId,resource.data.unitId)
            && request.resource.data.unitId == resource.data.unitId ));
      }

      // -----------------------------------------------------------------------------
      // A patient file may be shared by more than one unit: unitId is where the
      // bed is, unitIds is every unit allowed to read the file. Read stays
      // per-document, so a member only ever reaches a unit through his own
      // membership, never through another unit's id.
      match /patients/{patientId} {
        allow get: if adminOf(workspaceId)
          || unitMember(workspaceId,resource.data.get('unitId',''))
          || unitMemberAny(workspaceId,resource.data.get('unitIds', []));
        allow list: if adminOf(workspaceId)
          || unitMember(workspaceId,resource.data.get('unitId',''))
          || unitMemberAny(workspaceId,resource.data.get('unitIds', []));
        // A member creates a patient only inside a unit they are in, and may never
        // hand it to a unit they are not in: every id on unitIds must be their own
        // and the file's own unit must stay on the list. Owner is exempt.
        allow create: if canWrite(workspaceId) && (adminOf(workspaceId) || (clinicalEditor(workspaceId,request.resource.data.unitId)
          && ( !request.resource.data.keys().hasAny(['unitIds'])
               || ( request.resource.data.unitIds.hasOnly(memberUnits(workspaceId))
                    && request.resource.data.unitIds.hasAny([request.resource.data.unitId]) ) )));
        // An update needs editor rights on the new unit AND (same unit OR editor
        // rights on the old unit). This keeps legitimate transfers (dual-unit
        // editors, owner) while blocking cross-unit tampering via a unitId rewrite.
        // Adding a unit to unitIds is sharing, and is bounded by sharedUnitsWithin.
        allow update: if canWrite(workspaceId) && (adminOf(workspaceId) || (clinicalEditor(workspaceId,request.resource.data.unitId) && (request.resource.data.unitId == resource.data.unitId || clinicalEditor(workspaceId,resource.data.unitId)) && sharedUnitsWithin(workspaceId)));
        allow delete: if canWrite(workspaceId) && (adminOf(workspaceId) || clinicalEditor(workspaceId,resource.data.unitId));
      }

      // -----------------------------------------------------------------------------
      match /units/{unitId}/tasks/{taskId} {
        // Unit-shared task board: doctors of a unit follow every task of that
        // unit's patients. Scoping tasks under their unit keeps other units'
        // patient names out of reach. The old top-level /tasks collection has no
        // rule and is therefore denied by the default-deny tail.
        allow get, list, create, update: if canWrite(workspaceId) && (adminOf(workspaceId) || unitMember(workspaceId,unitId));
        allow delete: if canWrite(workspaceId) && adminOf(workspaceId);
      }

      // -----------------------------------------------------------------------------
      // Historical requests remain readable, but request creation is retired.
      match /subscriptionRequests/{requestId} {
        allow get: if adminOf(workspaceId)
          || (signedIn() && resource.data.subscriberId == request.auth.uid)
          // A brand-new account must be able to check whether its ONE onboarding
          // request exists yet (a retry must not guess). The document id is
          // deterministic and the workspace is its own, so this reveals nothing
          // but the caller's own request status.
          || (onboardingWorkspace(workspaceId) && requestId == onboardingRequestId(request.auth.uid));
        allow list: if adminOf(workspaceId);
        // One shared base runs once, then exactly one tail decides the shape.
        // Evaluating the whole validation twice (one copy per branch) exceeded
        // the 1000-expression budget and rejected every real request.
        allow create: if false;
        // The owner decides a request. The requester may only withdraw their
        // own pending request, and may never move it to approved.
        allow update: if (
            adminOf(workspaceId)
            && request.resource.data.subscriberId == resource.data.subscriberId
            && request.resource.data.workspaceId == workspaceId
            && request.resource.data.status in ['pending', 'approved', 'rejected', 'withdrawn']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','approvedAtMs','withdrawnAt','paymentVerified','paymentVerifiedAtMs',
              'paymentVerifiedBy','codes','updatedAtMs','provisioningState','provisionedUnitIds','unitAccessCodes'
            ])
            && (!request.resource.data.keys().hasAny(['updatedAtMs'])
                || (request.resource.data.updatedAtMs is int && request.resource.data.updatedAtMs > 0))
            && (!request.resource.data.keys().hasAny(['paymentVerified']) || request.resource.data.paymentVerified is bool)
            && (request.resource.data.get('paymentVerified', false) == false
                || (request.resource.data.get('paymentVerifiedAtMs', 0) is int
                    && request.resource.data.get('paymentVerifiedAtMs', 0) > 0
                    && request.resource.data.get('paymentVerifiedBy', '') is string
                    && request.resource.data.get('paymentVerifiedBy', '').size() <= 200))
            && (!request.resource.data.keys().hasAny(['codes'])
                || (request.resource.data.codes is list && request.resource.data.codes.size() <= 200))
            && (!request.resource.data.keys().hasAny(['provisioningState'])
                || request.resource.data.provisioningState in ['complete'])
            && (!request.resource.data.keys().hasAny(['provisionedUnitIds'])
                || (request.resource.data.provisionedUnitIds is list && request.resource.data.provisionedUnitIds.size() <= 51))
            && (!request.resource.data.keys().hasAny(['unitAccessCodes'])
                || (request.resource.data.unitAccessCodes is list && request.resource.data.unitAccessCodes.size() <= 51))
            && (request.resource.data.status != 'approved'
                || (request.resource.data.get('paymentVerified', false) == true
                    && request.resource.data.get('paymentVerifiedAtMs', 0) is int
                    && request.resource.data.get('paymentVerifiedAtMs', 0) > 0
                    && (request.resource.data.get('onboarding', false) != true
                        || (request.resource.data.get('provisioningState', '') == 'complete'
                            && request.resource.data.get('provisionedUnitIds', []).size() > 0
                            && request.resource.data.get('unitAccessCodes', []).size() > 0))))
          ) || (
            signedIn()
            && resource.data.subscriberId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt'])
          );
        allow delete: if adminOf(workspaceId);
      }

      // -----------------------------------------------------------------------------
      // One durable patient identity per workspace, shared by every unit that
      // treated the patient. `contextIds` is the unit list allowed to read it,
      // and a member may only ever add a unit they already belong to.
      match /masterFiles/{fileId} {
        allow get, list: if adminOf(workspaceId)
          || unitMemberAny(workspaceId, resource.data.get('contextIds', []));
        allow create: if canWrite(workspaceId)
          && signedIn()
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.get('contextIds', []).size() > 0
          && request.resource.data.get('contextIds', []).hasOnly(memberUnits(workspaceId));
        allow update: if canWrite(workspaceId)
          && ( adminOf(workspaceId)
               || unitMemberAny(workspaceId, resource.data.get('contextIds', [])) )
          && request.resource.data.get('contextIds', []).hasAll(resource.data.get('contextIds', []))
          && request.resource.data.get('contextIds', []).removeAll(resource.data.get('contextIds', [])).hasOnly(memberUnits(workspaceId))
          && unitMemberAny(workspaceId, request.resource.data.get('contextIds', []));
        allow delete: if adminOf(workspaceId);

        // Timeline events are separate immutable documents so concurrent
        // admission/transfer events cannot overwrite one another in an array.
        match /events/{eventId} {
          function parentFilePath() {
            return /databases/$(database)/documents/workspaces/$(workspaceId)/masterFiles/$(fileId);
          }
          function parentFileExists() { return exists(parentFilePath()); }
          function parentFile() { return get(parentFilePath()).data; }

          allow get, list: if parentFileExists()
            && (adminOf(workspaceId)
                || unitMemberAny(workspaceId, parentFile().get('contextIds', [])));
          allow create: if parentFileExists()
            && canWrite(workspaceId)
            && signedIn()
            && request.resource.data.id == eventId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.schemaVersion == 1
            && request.resource.data.refId == fileId
            && request.resource.data.get('context', {}).get('unitId', '') is string
            && parentFile().get('contextIds', []).hasAny([request.resource.data.get('context', {}).get('unitId', '')])
            && (adminOf(workspaceId)
                || unitMemberAny(workspaceId, parentFile().get('contextIds', [])));
          allow update, delete: if false;
        }
      }

      // -----------------------------------------------------------------------------
      // Scoped under the unit so one unit's queue can never be read through
      // another unit's membership.
      match /units/{unitId}/waiting/{entryId} {
        allow get, list: if adminOf(workspaceId) || unitMember(workspaceId, unitId);
        allow create, update: if canWrite(workspaceId)
          && ( adminOf(workspaceId) || unitMember(workspaceId, unitId) )
          && request.resource.data.unitId == unitId
          && request.resource.data.workspaceId == workspaceId;
        allow delete: if canWrite(workspaceId)
          && ( adminOf(workspaceId) || unitMember(workspaceId, unitId) );
      }

      match /metadata/{documentId} { allow read, write: if adminOf(workspaceId); }

      // -----------------------------------------------------------------------------
      match /media/{mediaId} {
        allow get: if adminOf(workspaceId) || unitMember(workspaceId, resource.data.unitId);
        allow create, update: if canWrite(workspaceId) && (adminOf(workspaceId) || clinicalEditor(workspaceId, request.resource.data.unitId));
        allow delete: if canWrite(workspaceId) && (adminOf(workspaceId) || clinicalEditor(workspaceId, resource.data.unitId));

        match /chunks/{chunkId} {
          allow read: if adminOf(workspaceId) ||
            (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)) &&
             unitMember(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)).data.unitId));

          allow create, update: if canWrite(workspaceId) && (adminOf(workspaceId) ||
            (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)) &&
             clinicalEditor(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)).data.unitId)));

          allow delete: if canWrite(workspaceId) && (adminOf(workspaceId) ||
            (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)) &&
             clinicalEditor(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)).data.unitId)));
        }
      }

      // -----------------------------------------------------------------------------
      // Append-only. Members may record their own actions (invites, joins);
      // only the owner reads the trail. Nothing can be edited or erased.
      match /audit/{eventId} {
        allow read: if adminOf(workspaceId);
        // Members record their own actions; the platform owner records his own
        // support access (he is not a member of customer workspaces). Nobody can
        // attribute an event to another account.
        allow create: if canWrite(workspaceId)
          && (adminOf(workspaceId) || member(workspaceId))
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.workspaceId == workspaceId;
        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------------
      // Hard rule: an account may append an event only to a unit it belongs to,
      // and only in its own name. The payload must agree with the path on all
      // three ids, so an event can never be filed against another unit or
      // another person. Append-only, exactly like the workspace trail above.
      match /units/{unitId}/audit/{eventId} {
        allow get, list: if adminOf(workspaceId) || unitMember(workspaceId, unitId);
        allow create: if canWrite(workspaceId)
          && unitMember(workspaceId, unitId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.unitId == unitId
          && request.resource.data.workspaceId == workspaceId;
        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------------
      // Unit license is authoritative for all members of exactly one unit.
      // Missing/expired licenses deny member access; memberships are untouched.
      match /unitLicenses/{unitId} {
        // Members may read only the license metadata for units they belong to,
        // including expired/missing status, so cached clinical screens can fail
        // closed. Listing remains owner-only.
        allow get: if adminOf(workspaceId) || memberHasUnit(workspaceId, unitId);
        allow list: if adminOf(workspaceId);
         allow create: if validOwnerInitialUnitLicense(workspaceId,unitId)
           || validOwnerUnitLicenseReset(workspaceId,unitId)
          || (licenseWriteUsesRedeemedCode(workspaceId,unitId)
          && request.resource.data.keys().hasOnly(['workspaceId','unitId','issuedAtMs','expiresAtMs','updatedBy','schemaVersion','activationCodeHash'])
          && request.resource.data.keys().hasAll(['workspaceId','unitId','issuedAtMs','expiresAtMs','updatedBy','schemaVersion','activationCodeHash'])
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.unitId == unitId
          && request.resource.data.issuedAtMs is int
          && request.resource.data.expiresAtMs is int
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.schemaVersion == 1);
         allow update: if validOwnerUnitLicenseReset(workspaceId,unitId)
           || (licenseWriteUsesRedeemedCode(workspaceId,unitId)
          && request.resource.data.keys().hasOnly(['workspaceId','unitId','issuedAtMs','expiresAtMs','updatedBy','schemaVersion','activationCodeHash'])
          && request.resource.data.keys().hasAll(['workspaceId','unitId','issuedAtMs','expiresAtMs','updatedBy','schemaVersion','activationCodeHash'])
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.unitId == unitId
          && request.resource.data.issuedAtMs is int
          && request.resource.data.expiresAtMs is int
          && request.resource.data.expiresAtMs > resource.data.expiresAtMs
          && request.resource.data.updatedBy == request.auth.uid
           && request.resource.data.schemaVersion == 1);
        allow delete: if false;
      }

      // One-use owner-issued renewal codes are unit-scoped. A member first
      // reserves the code for themselves, then atomically writes the matching
      // unit license in the same batch; retrying may finish their own redemption.
      match /unitLicenseCodes/{codeHash} {
        allow get: if adminOf(workspaceId) || (signedIn() && resource.data.unitId is string && memberHasUnit(workspaceId,resource.data.unitId));
        allow list: if adminOf(workspaceId);
        allow create: if adminOf(workspaceId)
          && request.resource.data.keys().hasOnly(['workspaceId','unitId','codeHash','issuedBy','issuedAtMs','codeExpiresAtMs','status','schemaVersion'])
          && request.resource.data.keys().hasAll(['workspaceId','unitId','codeHash','issuedBy','issuedAtMs','codeExpiresAtMs','status','schemaVersion'])
          && request.resource.data.workspaceId == workspaceId
          && request.resource.data.unitId is string
          && request.resource.data.codeHash == codeHash
          && request.resource.data.issuedBy == request.auth.uid
          && request.resource.data.issuedAtMs is int
          && request.resource.data.codeExpiresAtMs > request.time.toMillis()
          && request.resource.data.codeExpiresAtMs <= request.time.toMillis() + 2592000000
          && request.resource.data.status == 'active'
          && request.resource.data.schemaVersion == 1;
        allow update: if adminOf(workspaceId)
          || (validLicenseCodeRedemption(workspaceId,resource.data.unitId)
              && request.resource.data.keys().hasOnly(['workspaceId','unitId','codeHash','issuedBy','issuedAtMs','codeExpiresAtMs','status','schemaVersion','redeemedBy','redeemedAtMs','licenseExpiresAtMs'])
              && request.resource.data.keys().hasAll(['workspaceId','unitId','codeHash','issuedBy','issuedAtMs','codeExpiresAtMs','status','schemaVersion','redeemedBy','redeemedAtMs','licenseExpiresAtMs'])
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','redeemedBy','redeemedAtMs','licenseExpiresAtMs']));
        allow delete: if adminOf(workspaceId);
      }

      // Legacy workspace subscription clocks are retained for history but no
      // client may start a trial or renew the retired workspace-wide product.
      match /subscription/{documentId} {
        allow get, list: if adminOf(workspaceId);
        allow create, update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------------
    // One document the signed-in client reads to decide whether a newer build
    // exists on the store. Written from the console only, so no account can
    // advertise a fake update to another account.
    match /appConfig/{documentId} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }

    // Internal in-app owner queue for unit activation (not an OS push notification).
    // Requests contain operational metadata only, never patient information.
    match /unitActivationRequests/{requestId} {
      allow get, list: if platformOwner();
      allow create: if validUnitActivationRequestCreate(requestId);
      allow update: if platformOwner()
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.unitId == resource.data.unitId
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.requestedBedCount == resource.data.requestedBedCount
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && ((resource.data.status == 'pending'
              && request.resource.data.status == 'approving'
              && request.resource.data.approvedBy == request.auth.uid
              && request.resource.data.approvalStartedAtMs is int
              && request.resource.data.approvalStartedAtMs >= request.time.toMillis() - 120000
              && request.resource.data.approvalStartedAtMs <= request.time.toMillis() + 120000
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedBy','approvalStartedAtMs']))
            || (resource.data.status == 'approving'
              && request.resource.data.status == 'approved'
              && request.resource.data.approvedBy == resource.data.approvedBy
              && request.resource.data.approvalStartedAtMs == resource.data.approvalStartedAtMs
              && request.resource.data.approvedAtMs is int
              && request.resource.data.approvedAtMs >= request.time.toMillis() - 120000
              && request.resource.data.approvedAtMs <= request.time.toMillis() + 120000
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedAtMs'])));
      allow delete: if false;
    }

    // -----------------------------------------------------------------------------
    // Written only from the Firebase console: no client may create, modify or
    // list it. A uid can read its own entry so the app knows which screens to
    // show; the rules never rely on that read.
    match /platformOwners/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Every CardioVault account owns a completely private namespace.
    match /physicians/{uid} {
      allow read, write: if isOwner(uid);

      // Firestore rules do not automatically cascade from the parent document,
      // so the nested clinical collections must be protected explicitly.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny every unrelated collection/path by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

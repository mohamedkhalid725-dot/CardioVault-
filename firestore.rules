rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function masterAccount() { return signedIn() && request.auth.token.email == 'mohamedkhalid725@gmail.com'; }
    function masterWorkspace(workspaceId) { return workspaceId == 'cardiovault_master_workspace'; }
    function workspaceOwner(workspaceId) { return masterAccount() && masterWorkspace(workspaceId) && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid; }
    function member(workspaceId) { return signedIn() && masterWorkspace(workspaceId) && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)); }
    function memberData(workspaceId) { return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data; }
    function validAccessCode(hash) { return signedIn() && get(/databases/$(database)/documents/accessCodes/$(hash)).data.active == true && get(/databases/$(database)/documents/accessCodes/$(hash)).data.workspaceId == 'cardiovault_master_workspace'; }
    function unitMember(workspaceId,unitId) {
      return member(workspaceId) &&
        (
          (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/team/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/team/$(request.auth.uid)).data.status == 'active' &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/team/$(request.auth.uid)).data.assignedUnitIds.hasAny([unitId]))
          ||
          (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)/units/$(unitId)) &&
           get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)/units/$(unitId)).data.active == true &&
           validAccessCode(get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)/units/$(unitId)).data.accessCodeHash))
          ||
          (memberData(workspaceId).unitId == unitId && validAccessCode(memberData(workspaceId).accessCodeHash))
        );
    }
    function clinicalEditor(workspaceId,unitId) { return unitMember(workspaceId,unitId) && memberData(workspaceId).role == 'clinical_editor'; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} { allow read, write: if signedIn() && request.auth.uid == uid; }
    }

    match /accessCodes/{hash} {
      // Access-code permission fix: deployment trigger.
      // Access codes are looked up by their SHA-256 hash. Only signed-in users may
      // read an active master-workspace code so the redemption flow can validate it.
      allow get: if signedIn();
      allow create: if workspaceOwner(request.resource.data.workspaceId) && request.resource.data.workspaceId == 'cardiovault_master_workspace';
      allow update, delete: if workspaceOwner(resource.data.workspaceId) && resource.data.workspaceId == 'cardiovault_master_workspace';
    }

    match /workspaces/{workspaceId} {
      allow create: if masterAccount() && workspaceId == 'cardiovault_master_workspace' && request.resource.data.ownerUid == request.auth.uid && request.resource.data.ownerEmail == 'mohamedkhalid725@gmail.com';
      allow get, update, delete: if workspaceOwner(workspaceId);
      allow get: if member(workspaceId);

      match /members/{uid} {
        allow get: if workspaceOwner(workspaceId) || (signedIn() && request.auth.uid == uid);
        allow list: if workspaceOwner(workspaceId);
        allow create: if signedIn() && request.auth.uid == uid && workspaceId == 'cardiovault_master_workspace' && validAccessCode(request.resource.data.accessCodeHash) && request.resource.data.workspaceId == workspaceId && request.resource.data.uid == request.auth.uid && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.accessCodeHash)).data.workspaceId == workspaceId && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.accessCodeHash)).data.unitId == request.resource.data.unitId;
        allow update: if workspaceOwner(workspaceId) || (signedIn() && request.auth.uid == uid && workspaceId == 'cardiovault_master_workspace' && validAccessCode(request.resource.data.accessCodeHash) && request.resource.data.workspaceId == workspaceId && request.resource.data.uid == request.auth.uid && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.accessCodeHash)).data.workspaceId == workspaceId && get(/databases/$(database)/documents/accessCodes/$(request.resource.data.accessCodeHash)).data.unitId == request.resource.data.unitId);
        allow delete: if workspaceOwner(workspaceId);
      }

      match /members/{uid}/units/{unitId} {
        allow get, list: if workspaceOwner(workspaceId) || (signedIn() && request.auth.uid == uid);
        allow create, update: if workspaceOwner(workspaceId) ||
          (signedIn() && request.auth.uid == uid &&
           validAccessCode(request.resource.data.accessCodeHash) &&
           request.resource.data.uid == request.auth.uid &&
           request.resource.data.unitId == unitId);
        allow delete: if workspaceOwner(workspaceId);
      }

      match /accessCodes/{hash} { allow read, write: if workspaceOwner(workspaceId); }

      match /team/{uid} {
        allow get, list: if workspaceOwner(workspaceId);
        allow create, update: if workspaceOwner(workspaceId);
        allow delete: if workspaceOwner(workspaceId);
      }
      match /units/{unitId} { allow get: if workspaceOwner(workspaceId) || unitMember(workspaceId,unitId); allow list: if workspaceOwner(workspaceId); allow create, update, delete: if workspaceOwner(workspaceId); }
      match /beds/{bedId} {
        allow get: if workspaceOwner(workspaceId) || unitMember(workspaceId,resource.data.unitId);
        allow list: if workspaceOwner(workspaceId) || unitMember(workspaceId,resource.data.unitId);
        allow create, delete: if workspaceOwner(workspaceId);
        allow update: if workspaceOwner(workspaceId) || (clinicalEditor(workspaceId,resource.data.unitId) && request.resource.data.unitId == resource.data.unitId);
      }
      match /patients/{patientId} {
        allow get: if workspaceOwner(workspaceId) || unitMember(workspaceId,resource.data.unitId);
        allow list: if workspaceOwner(workspaceId) || unitMember(workspaceId,resource.data.unitId);
        allow create, update: if workspaceOwner(workspaceId) || clinicalEditor(workspaceId,request.resource.data.unitId);
        allow delete: if workspaceOwner(workspaceId) || clinicalEditor(workspaceId,resource.data.unitId);
      }
      match /metadata/{documentId} { allow read, write: if workspaceOwner(workspaceId); }

      match /media/{mediaId} {
        allow get: if workspaceOwner(workspaceId) || unitMember(workspaceId, resource.data.unitId);
        allow create, update: if workspaceOwner(workspaceId) || clinicalEditor(workspaceId, request.resource.data.unitId);
        allow delete: if workspaceOwner(workspaceId) || clinicalEditor(workspaceId, resource.data.unitId);

        match /chunks/{chunkId} {
          allow read: if workspaceOwner(workspaceId) ||
            (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)) &&
             unitMember(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)).data.unitId));

          allow create, update: if workspaceOwner(workspaceId) ||
            (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)) &&
             clinicalEditor(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)).data.unitId));

          allow delete: if workspaceOwner(workspaceId) ||
            (exists(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)) &&
             clinicalEditor(workspaceId, get(/databases/$(database)/documents/workspaces/$(workspaceId)/media/$(mediaId)).data.unitId));
        }
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}

{
  "name": "cardiovault",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:add": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "android:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "ios:prepare": "npm run build && npx cap sync ios",
    "test:firestore-rules": "npx firebase-tools@15.30.2 emulators:exec --only firestore \"node --test test/firestore.rules.test.js\"",
    "test:summary-input": "node --test test/patientSummaryInput.test.ts test/patientFilePhase2.test.ts test/examinationContent.test.ts test/patientAdmission.test.ts test/abgHistory.test.ts"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "7.5.0",
    "@capacitor-firebase/firestore": "7.3.0",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "7.1.8",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/local-notifications": "^7.0.7",
    "@capawesome/capacitor-file-picker": "7.2.0",
    "@google/genai": "^2.23.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "capacitor-voice-recorder": "7.0.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "11.10.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "@capacitor-firebase/app-check": "7.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@firebase/rules-unit-testing": "4.0.1"
  },
  "engines": {
    "node": "24.x"
  }
}

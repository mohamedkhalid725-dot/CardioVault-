{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/ai/scan-lab",
        "function": { "functionId": "scanLab", "region": "us-central1" }
      },
      {
        "source": "/api/ai/transcribe-clinical",
        "function": { "functionId": "transcribeClinical", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "CardioVault",
        "supportEmail": "mohamedkhalid725@gmail.com"
      }
    }
  }
}

# Server-side Gemini API Key for CardioVault AI Decision Support
GEMINI_API_KEY=

# Free-tier key for on-device-voice polish (Groq). Get one free at console.groq.com.
VITE_GROQ_API_KEY=

# Optional Supabase Integration (Leave empty to use Firestore / Local Storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local Firebase Emulator Suite: set to "true" to point the web build at the local
# Firestore/Auth/Storage emulators instead of production. Loaded by `vite --mode emulator` (.env.emulator).
# VITE_FIREBASE_EMULATOR=true

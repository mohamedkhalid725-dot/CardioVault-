# CardioVault AI backend endpoint.
# Leave empty to use the production Firebase Function automatically.
VITE_CARDIOVAULT_AI_ENDPOINT=""

# Google Identity Services OAuth 2.0 Web Client ID.
# Add this as a Vite/AI Studio secret as VITE_GOOGLE_CLIENT_ID.
# The deployed app origin must be configured as an Authorized JavaScript Origin in Google Cloud.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com"

# IMPORTANT:
# Do NOT put GEMINI_API_KEY in the Vite client environment.
# The Gemini key belongs only in Firebase Secret Manager for the AI backend.
